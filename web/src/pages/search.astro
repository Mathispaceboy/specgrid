---
import BaseLayout from '../layouts/BaseLayout.astro';
import { trackServer } from '../utils/tracking.js';

// Server-side tracking for directory search queries
const url = new URL(Astro.request.url);
const q = url.searchParams.get("q") || null;
const category = url.searchParams.get("category") || null;
const state = url.searchParams.get("state") || null;
const companyType = url.searchParams.get("company_type") || null;
const hasCertification = url.searchParams.get("has_certification") || null;

trackServer(Astro.request, "search", null, {
  q,
  category,
  state,
  companyType,
  hasCertification
}, Astro.locals);

const API_BASE = "https://specgrid-api.mathispaceboy.workers.dev";
---

<BaseLayout
  title="Search — SpecGrid"
  description="Search India's technical manufacturers by process, machine tonnage, alloy grade, company type, and certification."
  canonicalPath="/search"
>
  <div class="search-page wrap">
    <!-- Search Query Bar -->
    <section class="search-header">
      <form class="search-form-bar" id="searchBarForm" action="/search" method="get">
        <div class="search-input-box">
          <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="7"/>
            <line x1="21" y1="21" x2="16.65" y2="16.65"/>
          </svg>
          <input
            id="searchInput"
            name="q"
            type="text"
            autocomplete="off"
            placeholder='Search technical parameters: "800T die casting", "36kV VCB", "CPRI", "pipe-in-pipe", "IS 1180"...'
            class="search-input"
          />
          <button type="submit" class="btn btn-primary search-submit-btn" aria-label="Search">
            <span>Search</span> &rarr;
          </button>
        </div>
      </form>

      <!-- Quick Technical Parameter Shortcuts -->
      <div class="quick-specs-bar">
        <span class="quick-specs-label mono">SPEC SHORTCUTS:</span>
        <div class="quick-specs-chips">
          <a href="/search?q=800T" class="quick-chip mono">800T Die Casting</a>
          <a href="/search?q=36kV" class="quick-chip mono">36kV Switchgear</a>
          <a href="/search?q=CPRI" class="quick-chip mono">CPRI Type-Tested</a>
          <a href="/search?q=Pipe-in-Pipe" class="quick-chip mono">Pipe-in-Pipe Earthing</a>
          <a href="/search?q=IS+1180" class="quick-chip mono">IS 1180 Transformers</a>
          <a href="/search?q=H13" class="quick-chip mono">H13 Tool Steel</a>
          <a href="/search?q=CNC" class="quick-chip mono">CNC Toolroom</a>
          <a href="/search?q=Vacuum" class="quick-chip mono">Vacuum Interrupters</a>
        </div>
      </div>
    </section>


    <!-- Main Layout Grid: Facets Sidebar + Results Stream -->
    <div class="search-layout">
      <!-- Facets Sidebar -->
      <aside class="search-sidebar">
        <div class="sidebar-titleblock">
          <span class="tag" style="margin-bottom: 12px;">
            <span class="dot"></span>
            <span>Filter Criteria</span>
          </span>
        </div>

        <!-- Categories Filter -->
        <div class="filter-group">
          <div class="filter-label mono">Category</div>
          <div id="catFilters" class="cat-chips-wrap">
            <div class="skel" style="height: 28px; width: 90px; margin: 0 6px 6px 0; display: inline-block;"></div>
            <div class="skel" style="height: 28px; width: 120px; margin: 0 6px 6px 0; display: inline-block;"></div>
            <div class="skel" style="height: 28px; width: 80px; margin: 0 6px 6px 0; display: inline-block;"></div>
          </div>
        </div>

        <!-- Company Type Filter -->
        <div class="filter-group">
          <label for="typeFilter" class="filter-label mono">Company Type</label>
          <div class="select-wrap">
            <select id="typeFilter" class="custom-select">
              <option value="">All company types</option>
            </select>
          </div>
        </div>

        <!-- State Filter -->
        <div class="filter-group">
          <label for="stateFilter" class="filter-label mono">Location / State</label>
          <div class="select-wrap">
            <select id="stateFilter" class="custom-select">
              <option value="">All states</option>
            </select>
          </div>
        </div>

        <!-- Certification Checkbox -->
        <div class="filter-group">
          <label class="cert-checkbox-label">
            <input type="checkbox" id="certFilter" class="custom-checkbox" />
            <span>Has a certification on file</span>
          </label>
        </div>
      </aside>

      <!-- Results Column -->
      <main class="results-col">
        <!-- Active Filter Pills Bar -->
        <div id="activeFiltersBar" class="active-filters-bar" style="display: none;"></div>

        <!-- Results Header Metadata & Sort Selector -->
        <div class="results-header">
          <div id="resultMeta" class="results-meta mono">Loading results&hellip;</div>
          <div class="sort-wrap">
            <label for="sortSelect" class="sort-label mono">Sort:</label>
            <select id="sortSelect" class="sort-select custom-select mono">
              <option value="verified">Verified First</option>
              <option value="name_asc">Name (A–Z)</option>
              <option value="name_desc">Name (Z–A)</option>
              <option value="newest">Recently Added</option>
            </select>
          </div>
        </div>

        <!-- Results List -->
        <div id="resultList" class="results-list">
          <!-- Initial Loading Skeletons -->
          <div class="result-card skel" style="height: 100px;"></div>
          <div class="result-card skel" style="height: 100px;"></div>
          <div class="result-card skel" style="height: 100px;"></div>
        </div>

        <!-- Pagination Controls -->
        <nav id="paginationNav" class="pagination-nav" aria-label="Directory Pagination" style="display: none;"></nav>
      </main>
    </div>
  </div>
</BaseLayout>

<script is:inline define:vars={{ API_BASE }}>
  // Interactive search directory script with pagination, sorting, and active filter management
  (async () => {
    const b = API_BASE;
    const params = new URLSearchParams(window.location.search);
    const q = params.get("q") || "";
    const category = params.get("category") || "";
    const state = params.get("state") || "";
    const companyType = params.get("company_type") || "";
    const hasCert = params.get("has_certification") === "true";
    const sort = params.get("sort") || "verified";
    const page = Math.max(parseInt(params.get("page") || "1", 10), 1);

    const searchInput = document.getElementById("searchInput");
    if (searchInput) searchInput.value = q;

    const certFilter = document.getElementById("certFilter");
    if (certFilter) certFilter.checked = hasCert;

    const sortSelect = document.getElementById("sortSelect");
    if (sortSelect) sortSelect.value = sort;

    const typeLabels = {
      manufacturer: "Manufacturer",
      trader_distributor: "Trader / Distributor",
      service_provider: "Service provider",
      epc_contractor: "EPC contractor",
      other: "Other"
    };

    let categoriesMap = {};

    function currentParams(newPage = 1, newSort = null) {
      const p = new URLSearchParams();
      if (q) p.set("q", q);
      if (category) p.set("category", category);
      const t = document.getElementById("typeFilter") ? document.getElementById("typeFilter").value : "";
      if (t) p.set("company_type", t);
      const st = document.getElementById("stateFilter") ? document.getElementById("stateFilter").value : "";
      if (st) p.set("state", st);
      if (document.getElementById("certFilter") && document.getElementById("certFilter").checked) {
        p.set("has_certification", "true");
      }
      const srt = newSort !== null ? newSort : (document.getElementById("sortSelect") ? document.getElementById("sortSelect").value : sort);
      if (srt && srt !== "verified") {
        p.set("sort", srt);
      }
      if (newPage > 1) {
        p.set("page", String(newPage));
      }
      return p;
    }

    function applyFilters() {
      window.location.href = "/search?" + currentParams(1).toString();
    }

    if (sortSelect) {
      sortSelect.addEventListener("change", function() {
        window.location.href = "/search?" + currentParams(1, this.value).toString();
      });
    }

    window.removeFilter = function(filterKey) {
      const p = new URLSearchParams(window.location.search);
      p.delete(filterKey);
      p.delete("page");
      window.location.href = "/search?" + p.toString();
    };

    // 1. Populate Dropdown Filter Options
    try {
      const opts = await fetch(b + "/api/filter-options").then(r => r.json());
      const tf = document.getElementById("typeFilter");
      if (tf) {
        (opts.companyTypes || []).forEach(t => {
          const o = document.createElement("option");
          o.value = t;
          o.textContent = typeLabels[t] || t;
          if (t === companyType) o.selected = true;
          tf.appendChild(o);
        });
        tf.addEventListener("change", applyFilters);
      }

      const sf = document.getElementById("stateFilter");
      if (sf) {
        (opts.states || []).forEach(s => {
          const o = document.createElement("option");
          o.value = s;
          o.textContent = s;
          if (s === state) o.selected = true;
          sf.appendChild(o);
        });
        sf.addEventListener("change", applyFilters);
      }

      if (certFilter) {
        certFilter.addEventListener("change", applyFilters);
      }
    } catch(e) {}

    // 2. Populate Category Filter Chips
    try {
      const cats = await fetch(b + "/api/categories").then(r => r.json());
      const cf = document.getElementById("catFilters");
      if (cf) {
        cf.innerHTML = "";
        
        // "All categories" link
        const all = document.createElement("a");
        const ap = currentParams(1);
        ap.delete("category");
        all.href = "/search" + (ap.toString() ? "?" + ap.toString() : "");
        all.className = "cat-chip" + (!category ? " active" : "");
        all.innerHTML = '<span class="chip-indicator"></span>All categories';
        cf.appendChild(all);

        // Each specific category link
        (cats.results || []).forEach(c => {
          categoriesMap[c.slug] = c.name;
          const a = document.createElement("a");
          const p = currentParams(1);
          p.set("category", c.slug);
          a.href = "/search?" + p.toString();
          a.className = "cat-chip" + (category === c.slug ? " active" : "");
          a.innerHTML = '<span class="chip-indicator"></span>' + (c.name || "").replace(/</g, "&lt;");
          cf.appendChild(a);
        });
      }
    } catch(e) {
      const cf = document.getElementById("catFilters");
      if (cf) cf.innerHTML = '<div style="color:var(--ink-soft);font-size:12px;">Categories unavailable</div>';
    }

    // 3. Render Active Filter Badges Bar
    const activeFiltersBar = document.getElementById("activeFiltersBar");
    if (activeFiltersBar) {
      const pills = [];
      if (q) {
        pills.push('<span class="active-pill mono">Search: "' + q.replace(/</g, "&lt;") + '" <button type="button" onclick="removeFilter(\'q\')" aria-label="Remove search filter">&times;</button></span>');
      }
      if (category) {
        const catLabel = categoriesMap[category] || category.replace(/-/g, " ");
        pills.push('<span class="active-pill mono">Category: ' + catLabel.replace(/</g, "&lt;") + ' <button type="button" onclick="removeFilter(\'category\')" aria-label="Remove category filter">&times;</button></span>');
      }
      if (companyType) {
        const typeLabel = typeLabels[companyType] || companyType;
        pills.push('<span class="active-pill mono">Type: ' + typeLabel.replace(/</g, "&lt;") + ' <button type="button" onclick="removeFilter(\'company_type\')" aria-label="Remove company type filter">&times;</button></span>');
      }
      if (state) {
        pills.push('<span class="active-pill mono">State: ' + state.replace(/</g, "&lt;") + ' <button type="button" onclick="removeFilter(\'state\')" aria-label="Remove state filter">&times;</button></span>');
      }
      if (hasCert) {
        pills.push('<span class="active-pill mono">Has Certification <button type="button" onclick="removeFilter(\'has_certification\')" aria-label="Remove certification filter">&times;</button></span>');
      }

      if (pills.length > 0) {
        activeFiltersBar.style.display = "flex";
        activeFiltersBar.innerHTML =
          '<span class="active-label mono">Active filters:</span>' +
          pills.join("") +
          '<a href="/search" class="clear-all-link mono">Clear all filters</a>';
      } else {
        activeFiltersBar.style.display = "none";
      }
    }

    // 4. Populate Search Results with Pagination
    try {
      const p = new URLSearchParams();
      if (q) p.set("q", q);
      if (category) p.set("category", category);
      if (state) p.set("state", state);
      if (companyType) p.set("company_type", companyType);
      if (hasCert) p.set("has_certification", "true");
      if (sort && sort !== "verified") p.set("sort", sort);
      p.set("page", String(page));
      p.set("limit", "24");

      const data = await fetch(b + "/api/companies?" + p.toString()).then(r => r.json());
      const results = data.results || [];
      const total = data.total || 0;
      const totalPages = data.totalPages || Math.ceil(total / 24) || 1;
      const startIdx = total > 0 ? (data.offset || 0) + 1 : 0;
      const endIdx = (data.offset || 0) + results.length;

      const metaEl = document.getElementById("resultMeta");
      if (metaEl) {
        metaEl.innerHTML =
          'Showing <strong>' + startIdx + '&ndash;' + endIdx + '</strong> of <strong>' + total + '</strong> manufacturers' +
          (totalPages > 1 ? ' <span style="color:var(--ink-soft);font-weight:normal;">(Page ' + page + ' of ' + totalPages + ')</span>' : '');
      }

      const listEl = document.getElementById("resultList");
      if (listEl) {
        listEl.innerHTML = "";
        if (results.length === 0) {
          listEl.innerHTML = `
            <div class="empty-state">
              <div class="empty-title mono">NO SPECIFICATION MATCHES FOUND</div>
              <p>No matches yet — try a broader search query, remove an active filter, or explore by another category.</p>
              <div style="margin-top: 16px;">
                <a href="/search" class="btn btn-secondary mono" style="font-size: 12px;">Reset Directory Filters</a>
              </div>
            </div>
          `;
          const pagNav = document.getElementById("paginationNav");
          if (pagNav) pagNav.style.display = "none";
          return;
        }

        results.forEach(co => {
          const card = document.createElement("a");
          card.className = "result-card";
          card.href = "/companies/" + encodeURIComponent(co.slug);

          const loc = [co.location && co.location.city, co.location && co.location.state].filter(Boolean).join(", ");
          const statusBadgeCls = co.status === "founding" ? "badge-founding" : (co.status === "claimed" ? "badge-verified" : "badge-draft");
          const statusBadge = co.status === "founding" ? "Founding member" : (co.status === "claimed" ? "Verified" : "Draft profile");

          const metaBits = [loc];
          if (co.companyType) metaBits.push(typeLabels[co.companyType] || co.companyType.replace(/_/g, " "));
          if (co.foundedYear) metaBits.push("Est. " + co.foundedYear);

          const safeName = (co.name || "").replace(/</g, "&lt;");
          const safeMeta = metaBits.filter(Boolean).join(" · ").replace(/</g, "&lt;");
          const safeDesc = co.description ? co.description.replace(/</g, "&lt;").slice(0, 160) : "";

          let productsHtml = "";
          if (co.products && co.products.length > 0) {
            const chips = [];
            co.products.slice(0, 3).forEach(prod => {
              let cleanName = (prod.name || "")
                .replace(/^(Product Range|Flagship Product|Flagship Technology|Die Casting Tooling|Injection Molds|Distribution Transformers|Products|Services|Capabilities):\s*/i, "");
              if (cleanName.length > 40) cleanName = cleanName.slice(0, 38) + "…";
              chips.push('<span class="card-prod-chip">' + cleanName.replace(/</g, "&lt;") + '</span>');

              if (prod.specs && typeof prod.specs === "object") {
                for (const [k, v] of Object.entries(prod.specs)) {
                  const kLower = k.toLowerCase();
                  if (kLower.includes("tonnage") || kLower.includes("voltage") || kLower.includes("breaking") || kLower.includes("standard") || kLower.includes("fault") || kLower.includes("efficiency") || kLower.includes("capacity")) {
                    let valStr = String(v);
                    if (valStr.length > 35) valStr = valStr.slice(0, 33) + "…";
                    chips.push('<span class="card-spec-highlight mono">' + k.replace(/</g, "&lt;") + ': ' + valStr.replace(/</g, "&lt;") + '</span>');
                    break;
                  }
                }
              }
            });
            if (chips.length > 0) {
              productsHtml = '<div class="card-products-strip">' + chips.join("") + '</div>';
            }
          }

          card.innerHTML =
            '<div class="card-top">' +
              '<div>' +
                '<h3 class="card-name">' + safeName + '</h3>' +
                '<div class="card-meta mono">' + safeMeta + '</div>' +
              '</div>' +
              '<span class="badge ' + statusBadgeCls + '">' + statusBadge + '</span>' +
            '</div>' +
            (safeDesc ? '<p class="card-desc">' + safeDesc + '&hellip;</p>' : '') +
            productsHtml +
            '<div class="card-foot mono">' +
              '<span>View verified specifications & tooling</span>' +
              '<span class="card-arrow">&rarr;</span>' +
            '</div>';

          listEl.appendChild(card);
        });

        // 5. Render Pagination Navigation Controls
        const pagNav = document.getElementById("paginationNav");
        if (pagNav) {
          if (totalPages <= 1) {
            pagNav.style.display = "none";
            pagNav.innerHTML = "";
          } else {
            pagNav.style.display = "flex";
            let pagHtml = "";

            // Previous Button
            if (page > 1) {
              const prevParams = currentParams(page - 1);
              pagHtml += '<a href="/search?' + prevParams.toString() + '" class="pag-btn mono">&larr; Previous</a>';
            } else {
              pagHtml += '<span class="pag-btn disabled mono">&larr; Previous</span>';
            }

            // Page numbers with windowed delta
            pagHtml += '<div class="pag-numbers mono">';
            const delta = 2;
            const left = page - delta;
            const right = page + delta + 1;
            const range = [];
            const rangeWithDots = [];

            for (let i = 1; i <= totalPages; i++) {
              if (i === 1 || i === totalPages || (i >= left && i < right)) {
                range.push(i);
              }
            }

            let last;
            for (const i of range) {
              if (last) {
                if (i - last === 2) {
                  rangeWithDots.push(last + 1);
                } else if (i - last !== 1) {
                  rangeWithDots.push("...");
                }
              }
              rangeWithDots.push(i);
              last = i;
            }

            for (const item of rangeWithDots) {
              if (item === "...") {
                pagHtml += '<span class="pag-ellipsis">&hellip;</span>';
              } else if (item === page) {
                pagHtml += '<span class="pag-num active">' + item + '</span>';
              } else {
                const itemParams = currentParams(item);
                pagHtml += '<a href="/search?' + itemParams.toString() + '" class="pag-num">' + item + '</a>';
              }
            }
            pagHtml += '</div>';

            // Next Button
            if (page < totalPages) {
              const nextParams = currentParams(page + 1);
              pagHtml += '<a href="/search?' + nextParams.toString() + '" class="pag-btn mono">Next &rarr;</a>';
            } else {
              pagHtml += '<span class="pag-btn disabled mono">Next &rarr;</span>';
            }

            pagNav.innerHTML = pagHtml;
          }
        }
      }
    } catch(e) {
      const metaEl = document.getElementById("resultMeta");
      if (metaEl) metaEl.textContent = "Results are temporarily unavailable.";
    }
  })();
</script>

<style>
  .search-page {
    padding: 40px 24px 64px;
  }

  .search-header {
    margin-bottom: 32px;
  }

  .search-form-bar {
    max-width: 100%;
  }

  .search-input-box {
    display: flex;
    align-items: center;
    background: var(--card);
    border: 1.5px solid var(--ink);
    border-radius: var(--radius);
    padding: 4px 6px 4px 16px;
    box-shadow: 0 2px 5px rgba(20, 36, 46, 0.04);
  }

  .search-icon {
    width: 20px;
    height: 20px;
    color: var(--ink-soft);
    margin-right: 12px;
    flex-shrink: 0;
  }

  .search-input {
    flex: 1;
    border: none;
    outline: none;
    background: transparent;
    font-size: 16px;
    color: var(--ink);
    padding: 10px 0;
  }

  .search-submit-btn {
    padding: 10px 18px;
    font-size: 13px;
  }

  .quick-specs-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 14px;
    flex-wrap: wrap;
  }

  .quick-specs-label {
    font-size: 10.5px;
    font-weight: 700;
    color: var(--ink-soft);
    letter-spacing: 0.08em;
  }

  .quick-specs-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .quick-chip {
    font-size: 11px;
    padding: 3px 9px;
    border-radius: var(--radius);
    background: var(--paper);
    border: 1px solid var(--paper-line);
    color: var(--ink);
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .quick-chip:hover {
    border-color: var(--ink);
    background: var(--card);
    transform: translateY(-1px);
  }

  :global(.card-products-strip) {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 4px;
  }

  :global(.card-prod-chip) {
    font-size: 11px;
    font-weight: 500;
    padding: 3px 8px;
    border-radius: 3px;
    background: rgba(20, 36, 46, 0.04);
    color: var(--ink);
    border: 1px solid var(--paper-line);
  }

  :global(.card-spec-highlight) {
    font-size: 10.5px;
    padding: 3px 8px;
    border-radius: 3px;
    background: var(--green-soft);
    color: var(--green-deep);
    border: 1px solid rgba(31, 111, 74, 0.2);
    font-weight: 600;
  }

  /* Two-column layout */
  .search-layout {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 36px;
    align-items: start;
  }

  /* Sidebar */
  .search-sidebar {
    background: var(--card);
    border: 1px solid var(--paper-line);
    padding: 20px;
    border-radius: var(--radius);
  }

  .filter-group {
    margin-bottom: 22px;
  }

  .filter-group:last-child {
    margin-bottom: 0;
  }

  .filter-label {
    font-size: 11px;
    font-weight: 600;
    color: var(--ink-soft);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 10px;
    display: block;
  }

  .cat-chips-wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  :global(.cat-chip) {
    font-size: 12px;
    padding: 5px 10px;
    border: 1px solid var(--paper-line);
    border-radius: var(--radius);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--ink-soft);
    background: var(--paper);
    transition: border-color 0.15s ease, background 0.15s ease, color 0.15s ease;
  }

  :global(.cat-chip:hover) {
    border-color: var(--ink);
    color: var(--ink);
  }

  :global(.cat-chip.active) {
    color: var(--green-deep);
    font-weight: 600;
    background: var(--green-soft);
    border-color: rgba(31, 111, 74, 0.35);
  }

  :global(.chip-indicator) {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--green);
    display: inline-block;
  }

  .select-wrap {
    position: relative;
  }

  .custom-select {
    width: 100%;
    padding: 9px 12px;
    font-size: 13.5px;
    border: 1px solid var(--paper-line);
    border-radius: var(--radius);
    background: var(--paper);
    color: var(--ink);
    outline: none;
    cursor: pointer;
    transition: border-color 0.15s ease;
  }

  .custom-select:focus {
    border-color: var(--ink);
  }

  .cert-checkbox-label {
    display: flex;
    align-items: center;
    gap: 8px;
