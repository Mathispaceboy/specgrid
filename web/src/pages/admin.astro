---
import BaseLayout from '../layouts/BaseLayout.astro';

const CLERK_PUBLISHABLE_KEY = "pk_test_YnVzeS1jcmlja2V0LTExMzMuY2xlcmsuYWNjb3VudHMuZGV2JA";
const CLERK_FRONTEND_API = "https://busy-cricket-1133.clerk.accounts.dev";
const API_BASE = "https://specgrid-api.mathispaceboy.workers.dev";
---

<BaseLayout
  title="Admin — SpecGrid"
  description="SpecGrid admin — review claims and certifications."
  canonicalPath="/admin"
>
  <div class="admin-page wrap">
    <div class="titleblock" style="margin-bottom: 24px;">
      <div>Control<strong>Operator Administration</strong></div>
      <div>Access<strong>Moderator Key Required</strong></div>
      <div>Actions<strong>Verification &middot; Founding &middot; Telemetry</strong></div>
      <div>Status<strong>Production</strong></div>
    </div>

    <div id="clerkGate" class="auth-gate-box mono">Checking administrator privileges&hellip;</div>
    <div id="adminRoot" class="admin-root" style="display: none;"></div>
  </div>
</BaseLayout>

<script is:inline define:vars={{ CLERK_PUBLISHABLE_KEY, CLERK_FRONTEND_API, API_BASE }}>
  (function(){
    function esc(s){
      return String(s == null ? "" : s).replace(/[&<>"']/g, function(c){
        return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c];
      });
    }

    var s = document.createElement("script");
    s.setAttribute("data-clerk-publishable-key", CLERK_PUBLISHABLE_KEY);
    s.src = CLERK_FRONTEND_API + "/npm/@clerk/clerk-js@5/dist/clerk.browser.js";
    s.async = true;
    s.crossOrigin = "anonymous";

    s.addEventListener("load", async function(){
      try {
        await window.Clerk.load();
        var gate = document.getElementById("clerkGate");
        var root = document.getElementById("adminRoot");

        if (!window.Clerk.user) {
          if (gate) {
            gate.innerHTML = 'You need to be signed in as an administrator. <a href="/account" class="doc-link">Sign in &rarr;</a>';
          }
          return;
        }

        if (gate) gate.style.display = "none";
        if (root) root.style.display = "flex";

        try {
          var e = window.Clerk.user.primaryEmailAddress;
          if (e && window.__sg) window.__sg.identify(e.emailAddress);
        } catch(err) {}

        loadAdmin();
      } catch(err) {
        var gate = document.getElementById("clerkGate");
        if (gate) gate.textContent = "Could not load administrator session. Please refresh.";
      }
    });

    s.addEventListener("error", function(){
      var gate = document.getElementById("clerkGate");
      if (gate) gate.textContent = "Could not load administrator session. Please refresh.";
    });

    document.head.appendChild(s);

    async function authedFetch(path, opts){
      var token = await window.Clerk.session.getToken();
      opts = opts || {};
      opts.headers = Object.assign({}, opts.headers, { Authorization: "Bearer " + token });
      return fetch(API_BASE + path, opts);
    }

    async function loadAdmin(){
      var root = document.getElementById("adminRoot");
      if (!root) return;

      root.innerHTML =
        '<div class="admin-header-bar">' +
          '<div class="tag"><span class="dot"></span><span>Administration Console</span></div>' +
          '<h1 class="admin-title">Directory Operations</h1>' +
        '</div>' +

        '<!-- 1. Telemetry Section -->' +
        '<div class="admin-card">' +
          '<div class="card-label mono">01 // Telemetry &middot; Last 30 Days</div>' +
          '<div id="analyticsBody" class="mono loading-text">Loading platform telemetry&hellip;</div>' +
        '</div>' +

        '<!-- 2. Pending Claims Section -->' +
        '<div class="admin-card">' +
          '<div class="card-label mono">02 // Claim Moderation Queue</div>' +
          '<div id="claimsList" class="mono loading-text">Loading claims queue&hellip;</div>' +
        '</div>' +

        '<!-- 3. Unverified Certifications Section -->' +
        '<div class="admin-card">' +
          '<div class="card-label mono">03 // Certification Verification</div>' +
          '<div id="certsList" class="mono loading-text">Loading unverified certifications&hellip;</div>' +
        '</div>' +

        '<!-- 4. Mark Founding Member Section -->' +
        '<div class="admin-card">' +
          '<div class="card-label mono">04 // Manual Founding Assignment</div>' +
          '<h2 class="card-title" style="font-size: 18px;">Mark Founding Member</h2>' +
          '<p class="card-sub">Once payment is confirmed (UPI, bank transfer, etc.), record it here to flip the profile to Founding status.</p>' +
          '<div id="foundingStatus" class="mono founding-status-line">Checking quota&hellip;</div>' +
          '<form id="foundingForm" class="admin-form">' +
            '<div class="fld">' +
              '<label for="fm_slug" class="fld-label mono">Company Slug <span class="req">*</span></label>' +
              '<input id="fm_slug" required class="fld-input" placeholder="e.g. amptech-power-transformers" />' +
              '<div class="fld-hint mono">The slug part after /companies/ in the profile URL.</div>' +
            '</div>' +
            '<div class="fld-grid">' +
              '<div class="fld">' +
                '<label for="fm_amount" class="fld-label mono">Amount Paid</label>' +
                '<input id="fm_amount" class="fld-input" placeholder="e.g. ₹5000" />' +
              '</div>' +
              '<div class="fld">' +
                '<label for="fm_ref" class="fld-label mono">Payment Reference</label>' +
                '<input id="fm_ref" class="fld-input" placeholder="e.g. UPI txn ID" />' +
              '</div>' +
            '</div>' +
            '<div class="fld">' +
              '<label for="fm_notes" class="fld-label mono">Notes</label>' +
              '<input id="fm_notes" class="fld-input" placeholder="e.g. Elektrotec 2026 attendee" />' +
            '</div>' +
            '<div class="form-actions">' +
              '<button class="btn btn-primary" type="submit">Mark as founding member &rarr;</button>' +
            '</div>' +
            '<div id="foundingMsg" class="form-msg"></div>' +
          '</form>' +
        '</div>';

      refreshFoundingCount();
      loadAnalytics();

      // Wire Founding Form
      document.getElementById("foundingForm").addEventListener("submit", async function(e){
        e.preventDefault();
        var btn = e.target.querySelector("button[type='submit']");
        var msg = document.getElementById("foundingMsg");
        btn.disabled = true;
        btn.textContent = "Saving…";
        msg.className = "form-msg";

        var slug = document.getElementById("fm_slug").value.trim();
        try {
          var r = await authedFetch("/api/admin/founding/" + encodeURIComponent(slug), {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              amountPaid: document.getElementById("fm_amount").value || null,
              paymentReference: document.getElementById("fm_ref").value || null,
              notes: document.getElementById("fm_notes").value || null
            })
          });
          var data = await r.json();
          if (!r.ok) {
            msg.className = "form-msg err";
            msg.textContent = data.error || "Something went wrong.";
            btn.disabled = false;
            btn.textContent = "Mark as founding member →";
            return;
          }
          msg.className = "form-msg ok";
          msg.textContent = esc(slug) + " marked as founding member.";
          btn.disabled = false;
          btn.textContent = "Mark as founding member →";
          refreshFoundingCount();
        } catch(err) {
          msg.className = "form-msg err";
          msg.textContent = "Network error — please try again.";
          btn.disabled = false;
          btn.textContent = "Mark as founding member →";
        }
      });

      // Load Claims
      var claimsRes = await authedFetch("/api/admin/claims?status=pending");
      var claimsData = await claimsRes.json();
      var claimsEl = document.getElementById("claimsList");
      if (!claimsEl) return;

      if (!claimsRes.ok) {
        claimsEl.innerHTML = '<div class="alert-box err mono">' + esc(claimsData.error || "Could not load claims.") + '</div>';
      } else if (!claimsData.results.length) {
        claimsEl.innerHTML = '<p class="mono" style="color: var(--ink-soft); font-size: 13.5px;">No pending claims in moderation queue.</p>';
      } else {
        claimsEl.innerHTML = '<div class="claims-stack">' + claimsData.results.map(function(c){
          var gstinLine = c.gstin ? ('GSTIN: ' + esc(c.gstin) + (c.gstinValidFormat ? ' (format valid)' : ' (invalid format)')) : 'GSTIN: not provided';
          var cinLine = c.cin ? ('CIN: ' + esc(c.cin) + (c.cinValidFormat ? ' (format valid)' : ' (invalid format)')) : 'CIN: not provided';

          return (
            '<div class="claim-review-item" data-claim="' + esc(c.claimId) + '">' +
              '<div class="claim-meta-top">' +
                '<div>' +
                  '<div class="claim-co-name">' + esc(c.companyName) + '</div>' +
                  '<div class="claim-user-meta mono">' + esc(c.claimantName) + ' &middot; ' + esc(c.claimantEmail) + '</div>' +
                  '<div class="claim-site mono">Company site: ' + esc(c.companyWebsite || "—") + '</div>' +
                  '<div class="claim-legal mono">' + gstinLine + ' &middot; ' + cinLine + '</div>' +
                '</div>' +
              '</div>' +
              '<div class="checklist-panel">' +
                '<div class="checklist-title mono">Manual Verification Protocol</div>' +
                '<label class="chk-item"><input type="checkbox" class="chkLinkedin" /> <span>LinkedIn Presence verified (company and person)</span></label>' +
                '<label class="chk-item"><input type="checkbox" class="chkPresence" /> <span>Real online manufacturing presence confirmed</span></label>' +
                '<label class="chk-item"><input type="checkbox" class="chkGstin" /> <span>GSTIN / CIN format validated</span></label>' +
                '<label class="chk-item"><input type="checkbox" class="chkCalled" /> <span>Direct phone / message confirmation completed</span></label>' +
                '<input type="text" class="chkNotes fld-input" placeholder="Moderation notes (optional)" style="margin: 8px 0 12px; font-size: 12.5px;" />' +
                '<div class="chk-actions">' +
                  '<button class="btn btn-green btn-sm verifyApproveBtn">Approve as Verified &rarr;</button>' +
                  '<button class="btn btn-ghost btn-sm rejectBtn" style="color: var(--copper);">Reject</button>' +
                '</div>' +
              '</div>' +
            '</div>'
          );
        }).join("") + '</div>';

        claimsEl.querySelectorAll(".verifyApproveBtn").forEach(function(btn){
          btn.addEventListener("click", function(){ manuallyVerifyClaim(btn); });
        });
        claimsEl.querySelectorAll(".rejectBtn").forEach(function(btn){
          btn.addEventListener("click", function(){ actOnClaim(btn, "rejected"); });
        });
      }

      // Load Certifications
      var certsRes = await authedFetch("/api/admin/certifications");
      var certsData = await certsRes.json();
      var certsEl = document.getElementById("certsList");
      if (!certsEl) return;

      if (!certsRes.ok) {
        certsEl.innerHTML = '<div class="alert-box err mono">' + esc(certsData.error || "Could not load certifications.") + '</div>';
      } else if (!certsData.results.length) {
        certsEl.innerHTML = '<p class="mono" style="color: var(--ink-soft); font-size: 13.5px;">No unverified certifications.</p>';
      } else {
        certsEl.innerHTML = '<div class="certs-stack">' + certsData.results.map(function(c){
          return (
            '<div class="cert-review-item" data-cert="' + esc(c.id) + '">' +
              '<div>' +
                '<div class="cert-rev-name">' + esc(c.name) + (c.issuingBody ? ' &mdash; ' + esc(c.issuingBody) : '') + '</div>' +
                '<div class="cert-rev-co mono">' + esc(c.companyName) + '</div>' +
              '</div>' +
              '<button class="btn btn-dark btn-sm verifyCertBtn">Mark verified &rarr;</button>' +
            '</div>'
          );
        }).join("") + '</div>';

        certsEl.querySelectorAll(".verifyCertBtn").forEach(function(btn){
          btn.addEventListener("click", function(){ verifyCert(btn); });
        });
      }
    }

    async function actOnClaim(btn, status){
      var card = btn.closest("[data-claim]");
      var claimId = card.getAttribute("data-claim");
      card.querySelectorAll("button, input").forEach(function(b){ b.disabled = true; });
      btn.textContent = status === "approved" ? "Approving…" : "Rejecting…";

      try {
        var r = await authedFetch("/api/admin/claims/" + encodeURIComponent(claimId), {
          method: "PATCH",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ status: status })
        });
        if (!r.ok) {
          var d = await r.json();
          alert(d.error || "Something went wrong.");
          card.querySelectorAll("button, input").forEach(function(b){ b.disabled = false; });
          btn.textContent = status === "approved" ? "Approve" : "Reject";
          return;
        }
        card.style.opacity = "0.4";
        card.innerHTML = '<div class="mono" style="padding: 10px; color: var(--ink-soft);">' + (status === "approved" ? "Approved." : "Rejected.") + '</div>';
      } catch(e) {
        card.querySelectorAll("button, input").forEach(function(b){ b.disabled = false; });
        btn.textContent = status === "approved" ? "Approve" : "Reject";
      }
    }

    async function manuallyVerifyClaim(btn){
      var card = btn.closest("[data-claim]");
      var claimId = card.getAttribute("data-claim");
      card.querySelectorAll("button, input").forEach(function(b){ b.disabled = true; });
      btn.textContent = "Approving…";

      var payload = {
        linkedinChecked: card.querySelector(".chkLinkedin").checked,
        companyPresenceChecked: card.querySelector(".chkPresence").checked,
        gstinFormatChecked: card.querySelector(".chkGstin").checked,
        calledOrMessaged: card.querySelector(".chkCalled").checked,
        notes: card.querySelector(".chkNotes").value || null
      };

      try {
        var r = await authedFetch("/api/admin/claims/" + encodeURIComponent(claimId) + "/verify", {
          method: "PATCH",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload)
        });
        if (!r.ok) {
          var d = await r.json();
          alert(d.error || "Something went wrong.");
          card.querySelectorAll("button, input").forEach(function(b){ b.disabled = false; });
          btn.textContent = "Approve as Verified →";
          return;
        }
        card.style.opacity = "0.4";
        card.innerHTML = '<div class="mono" style="padding: 10px; color: var(--green-deep);">Approved — Profile flipped to Verified status.</div>';
      } catch(e) {
        card.querySelectorAll("button, input").forEach(function(b){ b.disabled = false; });
        btn.textContent = "Approve as Verified →";
      }
    }

    async function verifyCert(btn){
      var card = btn.closest("[data-cert]");
      var certId = card.getAttribute("data-cert");
      btn.disabled = true;
      btn.textContent = "Verifying…";

      try {
        var r = await authedFetch("/api/admin/certifications/" + encodeURIComponent(certId) + "/verify", {
          method: "PATCH"
        });
        if (!r.ok) {
          var d = await r.json();
          alert(d.error || "Something went wrong.");
          btn.disabled = false;
          btn.textContent = "Mark verified →";
          return;
        }
        card.style.opacity = "0.4";
        card.innerHTML = '<div class="mono" style="padding: 10px; color: var(--green-deep);">Certification Verified.</div>';
      } catch(e) {
        btn.disabled = false;
        btn.textContent = "Mark verified →";
      }
    }

    var EVENT_LABELS = {
      search: "Searches",
      company_view: "Profile views",
      enquiry_cta_click: "Enquiry clicks",
      enquiry_submitted: "Enquiries submitted",
      claim_submitted: "Claims submitted",
      founding_cta_click: "Founding CTA clicks",
      account_view: "Account views"
    };

    async function loadAnalytics(){
      var el = document.getElementById("analyticsBody");
      if (!el) return;

      try {
        var r = await authedFetch("/api/admin/analytics?days=30");
        var d = await r.json();
        if (!r.ok) {
          el.innerHTML = '<div class="alert-box err mono">' + esc(d.error || "Could not load analytics.") + '</div>';
          return;
        }

        var html = '<div class="telemetry-top-grid">';
        [["uniqueVisitors", "Unique Visitors"], ["sessions", "Sessions"], ["identifiedVisitors", "Identified Users"]].forEach(function(pair){
          html +=
            '<div class="telemetry-stat-card">' +
              '<div class="stat-big mono">' + (d[pair[0]] || 0) + '</div>' +
              '<div class="stat-lbl mono">' + esc(pair[1]) + '</div>' +
            '</div>';
        });
        html += '</div>';

        html += '<div class="events-grid">';
        Object.keys(EVENT_LABELS).forEach(function(key){
          var count = d.counts[key] || 0;
          html +=
            '<div class="event-tile">' +
              '<div class="event-count mono">' + count + '</div>' +
              '<div class="event-name mono">' + esc(EVENT_LABELS[key]) + '</div>' +
            '</div>';
        });
        html += '</div>';

        if (d.topSources && d.topSources.length) {
          html += '<div class="telemetry-sub-hdr mono">Traffic Sources</div><div class="telemetry-list">';
          d.topSources.forEach(function(s){
            html += '<div class="telemetry-row mono"><span>' + esc(s.source) + '</span><strong>' + s.count + ' sessions</strong></div>';
          });
          html += '</div>';
        }

        if (d.topLandingPages && d.topLandingPages.length) {
          html += '<div class="telemetry-sub-hdr mono">Top Landing Pages</div><div class="telemetry-list">';
          d.topLandingPages.forEach(function(p){
            html += '<div class="telemetry-row mono"><span>' + esc(p.page) + '</span><strong>' + p.count + '</strong></div>';
          });
          html += '</div>';
        }

        if (d.topCompanies && d.topCompanies.length) {
          html += '<div class="telemetry-sub-hdr mono">Most Viewed Profiles</div><div class="telemetry-list">';
          d.topCompanies.forEach(function(c){
            html += '<a class="telemetry-row mono" href="/companies/' + esc(c.slug) + '"><span>' + esc(c.slug) + '</span><strong>' + c.views + ' views &rarr;</strong></a>';
          });
          html += '</div>';
        }

        if (d.topQueries && d.topQueries.length) {
          html += '<div class="telemetry-sub-hdr mono">Top Search Queries</div><div class="telemetry-list">';
          d.topQueries.forEach(function(q){
            html += '<div class="telemetry-row mono"><span>' + esc(q.query) + '</span><strong>' + q.count + '&times;</strong></div>';
          });
          html += '</div>';
        }

        el.innerHTML = html;
      } catch(e) {
        el.innerHTML = '<div class="alert-box err mono">Could not load platform analytics.</div>';
      }
    }

    async function refreshFoundingCount(){
      var el = document.getElementById("foundingStatus");
      if (!el) return;

      try {
        var r = await fetch(API_BASE + "/api/founding-count");
        var d = await r.json();
        el.textContent = d.claimed + " of " + d.cap + " founding spots claimed (" + d.remaining + " remaining).";
      } catch(e) {
        el.textContent = "Could not load founding count.";
      }
    }
  })();
</script>

<style>
  .admin-page {
    padding: 36px 24px 72px;
  }

  .admin-title {
    font-size: 28px;
    letter-spacing: -0.02em;
    margin-top: 8px;
  }

  .admin-root {
    max-width: 820px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .auth-gate-box {
    border: 1px solid var(--paper-line);
    background: var(--card);
    padding: 28px;
    border-radius: var(--radius);
    text-align: center;
    color: var(--ink-soft);
    font-size: 14px;
    max-width: 540px;
    margin: 32px auto;
  }

  :global(.admin-card) {
    border: 1px solid var(--paper-line);
    background: var(--card);
    border-radius: var(--radius);
    padding: 28px;
    box-shadow: 0 1px 4px rgba(20, 36, 46, 0.04);
  }

  :global(.card-label) {
    font-size: 11px;
    font-weight: 600;
    color: var(--green);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 16px;
  }

  :global(.card-title) {
    letter-spacing: -0.01em;
    margin-bottom: 6px;
  }

  :global(.card-sub) {
    font-size: 14px;
    color: var(--ink-soft);
    margin-bottom: 18px;
    line-height: 1.55;
  }

  :global(.loading-text) {
    color: var(--ink-soft);
    font-size: 13.5px;
    text-align: center;
    padding: 16px 0;
  }

  :global(.telemetry-top-grid) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 16px;
    margin-bottom: 20px;
  }

  :global(.telemetry-stat-card) {
    background: var(--green-soft);
    border: 1px solid rgba(31, 111, 74, 0.3);
    padding: 16px 20px;
    border-radius: var(--radius);
  }

  :global(.stat-big) {
    font-size: 28px;
    font-weight: 700;
    color: var(--green-deep);
    line-height: 1;
    margin-bottom: 4px;
  }

  :global(.stat-lbl) {
    font-size: 11.5px;
    color: var(--ink-soft);
  }

  :global(.events-grid) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: 10px;
    margin-bottom: 24px;
  }

  :global(.event-tile) {
    border: 1px solid var(--paper-line);
    background: var(--paper);
    padding: 12px 14px;
    border-radius: var(--radius);
  }

  :global(.event-count) {
    font-size: 20px;
    font-weight: 700;
    color: var(--ink);
  }

  :global(.event-name) {
    font-size: 11px;
    color: var(--ink-soft);
    margin-top: 2px;
  }

  :global(.telemetry-sub-hdr) {
    font-size: 11.5px;
    font-weight: 600;
    color: var(--ink-soft);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 16px 0 8px;
  }

  :global(.telemetry-list) {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  :global(.telemetry-row) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 12px;
    background: var(--paper);
    border: 1px solid var(--paper-line);
    border-radius: var(--radius);
    font-size: 12.5px;
    text-decoration: none;
    color: inherit;
  }

  :global(.claims-stack), :global(.certs-stack) {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  :global(.claim-review-item), :global(.cert-review-item) {
    border: 1px solid var(--paper-line);
    background: var(--paper);
    padding: 20px;
    border-radius: var(--radius);
  }

  :global(.claim-co-name) {
    font-size: 17px;
    font-weight: 700;
    margin-bottom: 4px;
  }

  :global(.claim-user-meta), :global(.claim-site), :global(.claim-legal) {
    font-size: 12px;
    color: var(--ink-soft);
    line-height: 1.4;
  }

  :global(.checklist-panel) {
    border-top: 1px dashed var(--paper-line);
    padding-top: 14px;
    margin-top: 14px;
  }

  :global(.checklist-title) {
    font-size: 11px;
    font-weight: 600;
    color: var(--ink-soft);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 10px;
  }

  :global(.chk-item) {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--ink);
    margin-bottom: 6px;
    cursor: pointer;
  }

  :global(.chk-actions) {
    display: flex;
    gap: 10px;
    align-items: center;
  }

  :global(.cert-review-item) {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

