---
import BaseLayout from '../layouts/BaseLayout.astro';

const CLERK_PUBLISHABLE_KEY = "pk_test_YnVzeS1jcmlja2V0LTExMzMuY2xlcmsuYWNjb3VudHMuZGV2JA";
const CLERK_FRONTEND_API = "https://busy-cricket-1133.clerk.accounts.dev";
const API_BASE = "https://specgrid-api.mathispaceboy.workers.dev";
---

<BaseLayout
  title="Admin — SpecGrid"
  description="SpecGrid admin — review claims and certifications."
  canonicalPath="/admin"
>
  <div class="admin-page wrap">
    <div class="titleblock" style="margin-bottom: 24px;">
      <div>Control<strong>Operator Administration</strong></div>
      <div>Access<strong>Moderator Key Required</strong></div>
      <div>Actions<strong>Verification &middot; Founding &middot; Telemetry</strong></div>
      <div>Status<strong>Production</strong></div>
    </div>

    <div id="clerkGate" class="auth-gate-box mono">Checking administrator privileges&hellip;</div>
    <div id="adminRoot" class="admin-root" style="display: none;"></div>
  </div>
</BaseLayout>

<script is:inline define:vars={{ CLERK_PUBLISHABLE_KEY, CLERK_FRONTEND_API, API_BASE }}>
  (function(){
    function esc(s){
      return String(s == null ? "" : s).replace(/[&<>"']/g, function(c){
        return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c];
      });
    }

    var s = document.createElement("script");
    s.setAttribute("data-clerk-publishable-key", CLERK_PUBLISHABLE_KEY);
    s.src = CLERK_FRONTEND_API + "/npm/@clerk/clerk-js@5/dist/clerk.browser.js";
    s.async = true;
    s.crossOrigin = "anonymous";

    s.addEventListener("load", async function(){
      try {
        await window.Clerk.load();
        var gate = document.getElementById("clerkGate");
        var root = document.getElementById("adminRoot");

        if (!window.Clerk.user) {
          if (gate) {
            gate.innerHTML = 'You need to be signed in as an administrator. <a href="/account" class="doc-link">Sign in &rarr;</a>';
          }
          return;
        }

        if (gate) gate.style.display = "none";
        if (root) root.style.display = "flex";

        try {
          var e = window.Clerk.user.primaryEmailAddress;
          if (e && window.__sg) window.__sg.identify(e.emailAddress);
        } catch(err) {}

        loadAdmin();
      } catch(err) {
        var gate = document.getElementById("clerkGate");
        if (gate) gate.textContent = "Could not load administrator session. Please refresh.";
      }
    });

    s.addEventListener("error", function(){
      var gate = document.getElementById("clerkGate");
      if (gate) gate.textContent = "Could not load administrator session. Please refresh.";
    });

    document.head.appendChild(s);

    async function authedFetch(path, opts){
      var token = await window.Clerk.session.getToken();
      opts = opts || {};
      opts.headers = Object.assign({}, opts.headers, { Authorization: "Bearer " + token });
      return fetch(API_BASE + path, opts);
    }

    async function loadAdmin(){
      var root = document.getElementById("adminRoot");
      if (!root) return;

      root.innerHTML =
        '<div class="admin-header-bar">' +
          '<div class="tag"><span class="dot"></span><span>Administration Console</span></div>' +
          '<h1 class="admin-title">Directory Operations</h1>' +
        '</div>' +

        '<!-- 1. Telemetry Section -->' +
        '<div class="admin-card">' +
          '<div class="card-label mono">01 // Telemetry &middot; Last 30 Days</div>' +
          '<div id="analyticsBody" class="mono loading-text">Loading platform telemetry&hellip;</div>' +
        '</div>' +

        '<!-- 2. Pending Claims Section -->' +
        '<div class="admin-card">' +
          '<div class="card-label mono">02 // Claim Moderation Queue</div>' +
          '<div id="claimsList" class="mono loading-text">Loading claims queue&hellip;</div>' +
        '</div>' +

        '<!-- 3. Unverified Certifications Section -->' +
        '<div class="admin-card">' +
          '<div class="card-label mono">03 // Certification Verification</div>' +
          '<div id="certsList" class="mono loading-text">Loading unverified certifications&hellip;</div>' +
        '</div>' +

        '<!-- 4. Mark Founding Member Section -->' +
        '<div class="admin-card">' +
          '<div class="card-label mono">04 // Manual Founding Assignment</div>' +
          '<h2 class="card-title" style="font-size: 18px;">Mark Founding Member</h2>' +
          '<p class="card-sub">Once payment is confirmed (UPI, bank transfer, etc.), record it here to flip the profile to Founding status.</p>' +
          '<div id="foundingStatus" class="mono founding-status-line">Checking quota&hellip;</div>' +
          '<form id="foundingForm" class="admin-form">' +
            '<div class="fld">' +
              '<label for="fm_slug" class="fld-label mono">Company Slug <span class="req">*</span></label>' +
              '<input id="fm_slug" required class="fld-input" placeholder="e.g. amptech-power-transformers" />' +
              '<div class="fld-hint mono">The slug part after /companies/ in the profile URL.</div>' +
            '</div>' +
            '<div class="fld-grid">' +
              '<div class="fld">' +
                '<label for="fm_amount" class="fld-label mono">Amount Paid</label>' +
                '<input id="fm_amount" class="fld-input" placeholder="e.g. ₹5000" />' +
              '</div>' +
              '<div class="fld">' +
                '<label for="fm_ref" class="fld-label mono">Payment Reference</label>' +
                '<input id="fm_ref" class="fld-input" placeholder="e.g. UPI txn ID" />' +
              '</div>' +
            '</div>' +
            '<div class="fld">' +
              '<label for="fm_notes" class="fld-label mono">Notes</label>' +
              '<input id="fm_notes" class="fld-input" placeholder="e.g. Elektrotec 2026 attendee" />' +
            '</div>' +
            '<div class="form-actions">' +
              '<button class="btn btn-primary" type="submit">Mark as founding member &rarr;</button>' +
            '</div>' +
            '<div id="foundingMsg" class="form-msg"></div>' +
          '</form>' +
        '</div>' +

        '<!-- 5. Quick-Add Manufacturer Intake (CODISSIA & Expo Onboarding) -->' +
        '<div class="admin-card quick-add-card">' +
          '<div class="card-label mono">05 // Quick-Add Manufacturer Intake &middot; CODISSIA &amp; Expos</div>' +
          '<h2 class="card-title" style="font-size: 18px;">Quick-Add Manufacturer</h2>' +
          '<p class="card-sub">Fast on-the-fly intake for exhibitors met at CODISSIA (e.g. Inter Die Casting Expo) and industrial expos. Generates an indexed catalog profile (Draft status), assigns Spec ID, and creates an invite link for the company to claim and verify their listing.</p>' +

          '<div class="workflow-explainer mono">' +
            '<strong>Workflow:</strong> 1. Intake as <em>Draft Profile</em> &rarr; 2. Share WhatsApp claim invite &rarr; 3. Exhibitor submits at <code>/claim/[slug]</code> &rarr; 4. Claim appears in <em>02 // Claim Moderation Queue</em> above &rarr; 5. You verify checklist and click <em>Approve as Verified</em>.' +
          '</div>' +

          '<div class="preset-group">' +
            '<span class="mono" style="font-size: 11.5px; color: var(--ink-soft); display: block; margin-bottom: 6px;">Expo Quick Presets:</span>' +
            '<div class="preset-buttons">' +
              '<button type="button" class="btn btn-ghost btn-sm preset-btn" data-preset="die-casting">Inter Die Casting Expo</button>' +
              '<button type="button" class="btn btn-ghost btn-sm preset-btn" data-preset="machining">Precision CNC Machining</button>' +
              '<button type="button" class="btn btn-ghost btn-sm preset-btn" data-preset="tooling">Tooling &amp; Mold Maker</button>' +
              '<button type="button" class="btn btn-ghost btn-sm preset-btn" data-preset="switchgear">Switchgear &amp; Power</button>' +
            '</div>' +
          '</div>' +

          '<form id="quickAddForm" class="admin-form" style="margin-top: 18px;">' +
            '<div class="fld-grid">' +
              '<div class="fld">' +
                '<label for="qa_name" class="fld-label mono">Company Name <span class="req">*</span></label>' +
                '<input id="qa_name" required class="fld-input" placeholder="e.g. Apex Die Castings" />' +
              '</div>' +
              '<div class="fld">' +
                '<label for="qa_category" class="fld-label mono">Category <span class="req">*</span></label>' +
                '<select id="qa_category" required class="fld-input custom-select">' +
                  '<option value="die-casting">Die Casting &amp; Foundry</option>' +
                  '<option value="precision-machining">Precision Machining &amp; CNC</option>' +
                  '<option value="tooling-molds">Tooling, Dies &amp; Molds</option>' +
                  '<option value="pumps-motors">Pumps, Motors &amp; Drives</option>' +
                  '<option value="sheet-metal">Sheet Metal &amp; Fabrication</option>' +
                  '<option value="switchgear">Switchgear &amp; Panels</option>' +
                  '<option value="transformers">Transformers</option>' +
                  '<option value="automation">Industrial Automation &amp; Controls</option>' +
                  '<option value="cables">Cables &amp; Accessories</option>' +
                  '<option value="solar">Solar Energy Systems</option>' +
                  '<option value="other">Other</option>' +
                '</select>' +
              '</div>' +
            '</div>' +

            '<div class="fld-grid">' +
              '<div class="fld">' +
                '<label for="qa_city" class="fld-label mono">City</label>' +
                '<input id="qa_city" class="fld-input" value="Coimbatore" />' +
              '</div>' +
              '<div class="fld">' +
                '<label for="qa_state" class="fld-label mono">State</label>' +
                '<input id="qa_state" class="fld-input" value="Tamil Nadu" />' +
              '</div>' +
            '</div>' +

            '<div class="fld">' +
              '<label for="qa_desc" class="fld-label mono">Capabilities, Machine Tonnage &amp; Alloys <span class="req">*</span></label>' +
              '<textarea id="qa_desc" required class="fld-input fld-textarea" rows="3" placeholder="e.g. 800T HPDC and 400T LPDC aluminum die casting manufacturer specializing in automotive brackets, motor housings, and heat sinks with ADC12 and Zamak 3 alloys. In-house 4-axis VMC machining and CMM inspection."></textarea>' +
            '</div>' +

            '<div class="fld-grid">' +
              '<div class="fld">' +
                '<label for="qa_whatsapp" class="fld-label mono">WhatsApp Number (Direct)</label>' +
                '<input id="qa_whatsapp" class="fld-input" placeholder="e.g. 919876543210" />' +
                '<div class="fld-hint mono">Include country code (e.g. 91...) for 1-tap WhatsApp followup.</div>' +
              '</div>' +
              '<div class="fld">' +
                '<label for="qa_website" class="fld-label mono">Website / Catalog URL</label>' +
                '<input id="qa_website" class="fld-input" placeholder="e.g. https://apexcasting.in" />' +
              '</div>' +
            '</div>' +

            '<div class="fld-grid">' +
              '<div class="fld">' +
                '<label for="qa_status" class="fld-label mono">Initial Status</label>' +
                '<select id="qa_status" class="fld-input custom-select">' +
                  '<option value="draft" selected>Draft Profile (Standard Unclaimed Entry)</option>' +
                  '<option value="claimed">Claimed Profile (Domain Matched)</option>' +
                  '<option value="verified">Verified (Manual Protocol Completed)</option>' +
                  '<option value="founding">Founding Member</option>' +
                '</select>' +
                '<div class="fld-hint mono">New entries start as Draft. Only mark Verified if you have already completed full manual review.</div>' +
              '</div>' +
              '<div class="fld">' +
                '<label for="qa_sourcenote" class="fld-label mono">Source / Event Note</label>' +
                '<input id="qa_sourcenote" class="fld-input" value="CODISSIA Inter Die Casting Expo 2026" />' +
              '</div>' +
            '</div>' +

            '<div class="fld">' +
              '<label class="fld-label mono">Certifications &amp; Standards (Quick Select)</label>' +
              '<div class="cert-checkbox-grid">' +
                '<label class="chk-item"><input type="checkbox" name="qa_cert" value="IATF 16949" checked /> <span>IATF 16949 (Automotive)</span></label>' +
                '<label class="chk-item"><input type="checkbox" name="qa_cert" value="ISO 9001:2015" checked /> <span>ISO 9001:2015</span></label>' +
                '<label class="chk-item"><input type="checkbox" name="qa_cert" value="ISO 14001" /> <span>ISO 14001 (Environmental)</span></label>' +
                '<label class="chk-item"><input type="checkbox" name="qa_cert" value="AS 9100" /> <span>AS 9100 (Aerospace)</span></label>' +
                '<label class="chk-item"><input type="checkbox" name="qa_cert" value="CE Marked" /> <span>CE Marked</span></label>' +
              '</div>' +
            '</div>' +

            '<div class="form-actions">' +
              '<button class="btn btn-primary" type="submit" id="qaSubmitBtn">Create &amp; Index Supplier &rarr;</button>' +
            '</div>' +
            '<div id="qaMsg" class="form-msg"></div>' +
          '</form>' +

          '<!-- Post-Submission Instant Action Panel -->' +
          '<div id="qaSuccessCard" class="qa-success-card" style="display: none;">' +
            '<div class="qa-success-header">' +
              '<span class="badge badge-draft mono" id="qaSuccessBadge">DRAFT PROFILE (INDEXED)</span>' +
              '<span class="mono" id="qaSuccessSpecId" style="font-size: 13px; color: var(--ink-soft);"></span>' +
            '</div>' +
            '<h3 id="qaSuccessName" class="qa-success-title"></h3>' +
            '<p id="qaSuccessUrl" class="mono qa-success-url"></p>' +
            '<div class="qa-action-buttons">' +
              '<a id="qaViewProfileBtn" href="#" target="_blank" class="btn btn-dark btn-sm">Open Live Profile &rarr;</a>' +
              '<a id="qaClaimLink" href="#" target="_blank" class="btn btn-ghost btn-sm mono">Open Claim Page &rarr;</a>' +
              '<a id="qaWaLink" href="#" target="_blank" class="btn wa-btn btn-sm">' +
                '<svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.28-1.38c1.45.79 3.08 1.21 4.76 1.21h.01c5.46 0 9.9-4.45 9.9-9.91C21.96 6.45 17.5 2 12.04 2zm0 18.15h-.01c-1.5 0-2.97-.4-4.24-1.16l-.3-.18-3.15.83.84-3.08-.2-.32a8.19 8.19 0 01-1.26-4.4c0-4.53 3.7-8.22 8.24-8.22 2.2 0 4.27.86 5.83 2.42a8.14 8.14 0 012.41 5.81c0 4.54-3.7 8.23-8.24 8.23z"/></svg>' +
                '<span>Send WhatsApp Invite</span>' +
              '</a>' +
              '<button type="button" id="qaCopyBadgeBtn" class="btn btn-ghost btn-sm mono">Copy Badge HTML</button>' +
              '<button type="button" id="qaResetBtn" class="btn btn-ghost btn-sm mono">Add Another Exhibitor +</button>' +
            '</div>' +
          '</div>' +
        '</div>';



      refreshFoundingCount();
      loadAnalytics();

      // Wire Founding Form
      document.getElementById("foundingForm").addEventListener("submit", async function(e){
        e.preventDefault();
        var btn = e.target.querySelector("button[type='submit']");
        var msg = document.getElementById("foundingMsg");
        btn.disabled = true;
        btn.textContent = "Saving…";
        msg.className = "form-msg";

        var slug = document.getElementById("fm_slug").value.trim();
        try {
          var r = await authedFetch("/api/admin/founding/" + encodeURIComponent(slug), {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              amountPaid: document.getElementById("fm_amount").value || null,
              paymentReference: document.getElementById("fm_ref").value || null,
              notes: document.getElementById("fm_notes").value || null
            })
          });
          var data = await r.json();
          if (!r.ok) {
            msg.className = "form-msg err";
            msg.textContent = data.error || "Something went wrong.";
            btn.disabled = false;
            btn.textContent = "Mark as founding member →";
            return;
          }
          msg.className = "form-msg ok";
          msg.textContent = esc(slug) + " marked as founding member.";
          btn.disabled = false;
          btn.textContent = "Mark as founding member →";
          refreshFoundingCount();
        } catch(err) {
          msg.className = "form-msg err";
          msg.textContent = "Network error — please try again.";
          btn.disabled = false;
          btn.textContent = "Mark as founding member →";
        }
      });

      // Wire Quick-Add Presets
      document.querySelectorAll(".preset-btn").forEach(function(btn){
        btn.addEventListener("click", function(){
          var p = btn.getAttribute("data-preset");
          var catSel = document.getElementById("qa_category");
          var descEl = document.getElementById("qa_desc");
          var noteEl = document.getElementById("qa_sourcenote");

          // Reset all preset button active styling
          document.querySelectorAll(".preset-btn").forEach(function(b){
            b.style.borderColor = "var(--paper-line)";
            b.style.color = "var(--ink-soft)";
          });
          btn.style.borderColor = "var(--green-deep)";
          btn.style.color = "var(--green-deep)";

          if (p === "die-casting") {
            if (catSel) catSel.value = "die-casting";
            if (descEl) descEl.value = "High pressure die casting (HPDC) and gravity die casting (GDC) facility specializing in aluminum and zinc components (ADC12, AlSi9Cu3, Zamak 3/5). Equipped with 400T–1200T machines, in-house CNC machining, and CMM inspection.";
            if (noteEl) noteEl.value = "CODISSIA Inter Die Casting Expo 2026";
          } else if (p === "machining") {
            if (catSel) catSel.value = "precision-machining";
            if (descEl) descEl.value = "Precision CNC turning and 4-axis / 5-axis VMC machining facility. Specializing in close-tolerance automotive, aerospace, and hydraulic components with surface roughness testing and CMM validation.";
            if (noteEl) noteEl.value = "CODISSIA Inter Die Casting Expo 2026";
          } else if (p === "tooling") {
            if (catSel) catSel.value = "tooling-molds";
            if (descEl) descEl.value = "High-precision mold and die manufacturing facility designing and producing pressure die casting dies, plastic injection molds, and progressive stamping tools.";
            if (noteEl) noteEl.value = "CODISSIA Inter Die Casting Expo 2026";
          } else if (p === "switchgear") {
            if (catSel) catSel.value = "switchgear";
            if (descEl) descEl.value = "Manufacturer of LT/HT switchgear panels, motor control centers (MCC), power control centers (PCC), APFC panels, and customized industrial distribution boards.";
            if (noteEl) noteEl.value = "CODISSIA Industrial Expo Attendee";
          }
        });
      });

      // Wire Quick-Add Form Submission
      var qaForm = document.getElementById("quickAddForm");
      if (qaForm) {
        qaForm.addEventListener("submit", async function(e){
          e.preventDefault();
          var btn = document.getElementById("qaSubmitBtn");
          var msg = document.getElementById("qaMsg");
          var successCard = document.getElementById("qaSuccessCard");
          btn.disabled = true;
          btn.textContent = "Creating & Indexing…";
          msg.className = "form-msg";
          successCard.style.display = "none";

          var certs = [];
          document.querySelectorAll("input[name='qa_cert']:checked").forEach(function(c){
            certs.push(c.value);
          });

          var payload = {
            name: document.getElementById("qa_name").value.trim(),
            categoryId: document.getElementById("qa_category").value,
            locationCity: document.getElementById("qa_city").value.trim(),
            locationState: document.getElementById("qa_state").value.trim(),
            description: document.getElementById("qa_desc").value.trim(),
            whatsappNumber: document.getElementById("qa_whatsapp").value.trim() || null,
            website: document.getElementById("qa_website").value.trim() || null,
            status: document.getElementById("qa_status").value,
            sourceNote: document.getElementById("qa_sourcenote").value.trim(),
            certifications: certs
          };

          try {
            var r = await fetch("/api/admin/create-company", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify(payload)
            });
            var data = await r.json();
            if (!r.ok) {
              msg.className = "form-msg err";
              msg.textContent = data.error || "Could not create company.";
              btn.disabled = false;
              btn.textContent = "Create & Index Supplier →";
              return;
            }

            msg.className = "form-msg ok";
            msg.textContent = "Supplier successfully indexed in SpecGrid!";
            btn.disabled = false;
            btn.textContent = "Create & Index Supplier →";

            // Populate Success Card
            document.getElementById("qaSuccessName").textContent = data.name;
            document.getElementById("qaSuccessSpecId").textContent = data.specId;
            document.getElementById("qaSuccessUrl").textContent = "specgrid.in" + data.profileUrl;
            document.getElementById("qaViewProfileBtn").href = data.profileUrl;
            var claimLinkEl = document.getElementById("qaClaimLink");
            if (claimLinkEl) claimLinkEl.href = "/claim/" + data.slug;

            var badgeEl = document.getElementById("qaSuccessBadge");
            if (badgeEl) {
              if (data.status === "verified") {
                badgeEl.className = "badge badge-verified mono";
                badgeEl.textContent = "VERIFIED SUPPLIER";
              } else if (data.status === "founding") {
                badgeEl.className = "badge badge-founding mono";
                badgeEl.textContent = "FOUNDING MEMBER";
              } else if (data.status === "claimed") {
                badgeEl.className = "badge badge-claimed mono";
                badgeEl.textContent = "CLAIMED PROFILE";
              } else {
                badgeEl.className = "badge badge-draft mono";
                badgeEl.textContent = "DRAFT PROFILE (INDEXED)";
              }
            }

            // WhatsApp link: Invite them to claim and verify
            var rawWa = payload.whatsappNumber ? payload.whatsappNumber.replace(/[^0-9]/g, "") : "";
            var waGreeting = "Hi " + payload.name + " team, great connecting at the Inter Die Casting Expo at CODISSIA today! We have indexed your catalog profile on SpecGrid: https://specgrid.in" + data.profileUrl + " — you can review and claim your free profile to update your machine specs, casting tonnage, and verified certifications: https://specgrid.in/claim/" + data.slug;
            var waLinkEl = document.getElementById("qaWaLink");
            if (rawWa) {
              waLinkEl.href = "https://wa.me/" + rawWa + "?text=" + encodeURIComponent(waGreeting);
              waLinkEl.style.display = "inline-flex";
            } else {
              waLinkEl.style.display = "none";
            }

            // Copy Badge Snippet
            var copyBadgeBtn = document.getElementById("qaCopyBadgeBtn");
            copyBadgeBtn.onclick = function(){
              var snippet = '<a href="https://specgrid.in' + data.profileUrl + '" target="_blank" rel="noopener"><img src="https://specgrid.in/badge/' + data.slug + '.svg" alt="' + esc(data.name) + ' SpecGrid Profile" width="320" height="64" /></a>';
              navigator.clipboard.writeText(snippet);
              copyBadgeBtn.textContent = "Copied!";
              setTimeout(function(){ copyBadgeBtn.textContent = "Copy Badge HTML"; }, 2000);
            };


            // Reset Button
            document.getElementById("qaResetBtn").onclick = function(){
              qaForm.reset();
              successCard.style.display = "none";
              msg.className = "form-msg";
              document.getElementById("qa_city").value = "Coimbatore";
              document.getElementById("qa_state").value = "Tamil Nadu";
              document.getElementById("qa_sourcenote").value = "CODISSIA Inter Die Casting Expo 2026";
            };

            successCard.style.display = "block";
            successCard.scrollIntoView({ behavior: "smooth" });
          } catch(err) {
            msg.className = "form-msg err";
            msg.textContent = "Network error — please check connection and try again.";
            btn.disabled = false;
            btn.textContent = "Create & Index Supplier →";
          }
        });
      }


      // Load Claims
      var claimsRes = await authedFetch("/api/admin/claims?status=pending");
      var claimsData = await claimsRes.json();
      var claimsEl = document.getElementById("claimsList");
      if (!claimsEl) return;

      if (!claimsRes.ok) {
        claimsEl.innerHTML = '<div class="alert-box err mono">' + esc(claimsData.error || "Could not load claims.") + '</div>';
      } else if (!claimsData.results.length) {
        claimsEl.innerHTML = '<p class="mono" style="color: var(--ink-soft); font-size: 13.5px;">No pending claims in moderation queue.</p>';
      } else {
        claimsEl.innerHTML = '<div class="claims-stack">' + claimsData.results.map(function(c){
          var gstinLine = c.gstin ? ('GSTIN: ' + esc(c.gstin) + (c.gstinValidFormat ? ' (format valid)' : ' (invalid format)')) : 'GSTIN: not provided';
          var cinLine = c.cin ? ('CIN: ' + esc(c.cin) + (c.cinValidFormat ? ' (format valid)' : ' (invalid format)')) : 'CIN: not provided';

          return (
            '<div class="claim-review-item" data-claim="' + esc(c.claimId) + '">' +
              '<div class="claim-meta-top">' +
                '<div>' +
                  '<div class="claim-co-name">' + esc(c.companyName) + '</div>' +
                  '<div class="claim-user-meta mono">' + esc(c.claimantName) + ' &middot; ' + esc(c.claimantEmail) + '</div>' +
                  '<div class="claim-site mono">Company site: ' + esc(c.companyWebsite || "—") + '</div>' +
                  '<div class="claim-legal mono">' + gstinLine + ' &middot; ' + cinLine + '</div>' +
                '</div>' +
              '</div>' +
              '<div class="checklist-panel">' +
                '<div class="checklist-title mono">Manual Verification Protocol</div>' +
                '<label class="chk-item"><input type="checkbox" class="chkLinkedin" /> <span>LinkedIn Presence verified (company and person)</span></label>' +
                '<label class="chk-item"><input type="checkbox" class="chkPresence" /> <span>Real online manufacturing presence confirmed</span></label>' +
                '<label class="chk-item"><input type="checkbox" class="chkGstin" /> <span>GSTIN / CIN format validated</span></label>' +
                '<label class="chk-item"><input type="checkbox" class="chkCalled" /> <span>Direct phone / message confirmation completed</span></label>' +
                '<input type="text" class="chkNotes fld-input" placeholder="Moderation notes (optional)" style="margin: 8px 0 12px; font-size: 12.5px;" />' +
                '<div class="chk-actions">' +
                  '<button class="btn btn-green btn-sm verifyApproveBtn">Approve as Verified &rarr;</button>' +
                  '<button class="btn btn-ghost btn-sm rejectBtn" style="color: var(--copper);">Reject</button>' +
                '</div>' +
              '</div>' +
            '</div>'
          );
        }).join("") + '</div>';

        claimsEl.querySelectorAll(".verifyApproveBtn").forEach(function(btn){
          btn.addEventListener("click", function(){ manuallyVerifyClaim(btn); });
        });
        claimsEl.querySelectorAll(".rejectBtn").forEach(function(btn){
          btn.addEventListener("click", function(){ actOnClaim(btn, "rejected"); });
        });
      }

      // Load Certifications
      var certsRes = await authedFetch("/api/admin/certifications");
      var certsData = await certsRes.json();
      var certsEl = document.getElementById("certsList");
      if (!certsEl) return;

      if (!certsRes.ok) {
        certsEl.innerHTML = '<div class="alert-box err mono">' + esc(certsData.error || "Could not load certifications.") + '</div>';
      } else if (!certsData.results.length) {
        certsEl.innerHTML = '<p class="mono" style="color: var(--ink-soft); font-size: 13.5px;">No unverified certifications.</p>';
      } else {
        certsEl.innerHTML = '<div class="certs-stack">' + certsData.results.map(function(c){
          return (
            '<div class="cert-review-item" data-cert="' + esc(c.id) + '">' +
              '<div>' +
                '<div class="cert-rev-name">' + esc(c.name) + (c.issuingBody ? ' &mdash; ' + esc(c.issuingBody) : '') + '</div>' +
                '<div class="cert-rev-co mono">' + esc(c.companyName) + '</div>' +
              '</div>' +
              '<button class="btn btn-dark btn-sm verifyCertBtn">Mark verified &rarr;</button>' +
            '</div>'
          );
        }).join("") + '</div>';

        certsEl.querySelectorAll(".verifyCertBtn").forEach(function(btn){
          btn.addEventListener("click", function(){ verifyCert(btn); });
        });
      }
    }

    async function actOnClaim(btn, status){
      var card = btn.closest("[data-claim]");
      var claimId = card.getAttribute("data-claim");
      card.querySelectorAll("button, input").forEach(function(b){ b.disabled = true; });
      btn.textContent = status === "approved" ? "Approving…" : "Rejecting…";

      try {
        var r = await authedFetch("/api/admin/claims/" + encodeURIComponent(claimId), {
          method: "PATCH",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ status: status })
        });
        if (!r.ok) {
          var d = await r.json();
          alert(d.error || "Something went wrong.");
          card.querySelectorAll("button, input").forEach(function(b){ b.disabled = false; });
          btn.textContent = status === "approved" ? "Approve" : "Reject";
          return;
        }
        card.style.opacity = "0.4";
        card.innerHTML = '<div class="mono" style="padding: 10px; color: var(--ink-soft);">' + (status === "approved" ? "Approved." : "Rejected.") + '</div>';
      } catch(e) {
        card.querySelectorAll("button, input").forEach(function(b){ b.disabled = false; });
        btn.textContent = status === "approved" ? "Approve" : "Reject";
      }
    }

    async function manuallyVerifyClaim(btn){
      var card = btn.closest("[data-claim]");
      var claimId = card.getAttribute("data-claim");
      card.querySelectorAll("button, input").forEach(function(b){ b.disabled = true; });
      btn.textContent = "Approving…";

      var payload = {
        linkedinChecked: card.querySelector(".chkLinkedin").checked,
        companyPresenceChecked: card.querySelector(".chkPresence").checked,
        gstinFormatChecked: card.querySelector(".chkGstin").checked,
        calledOrMessaged: card.querySelector(".chkCalled").checked,
        notes: card.querySelector(".chkNotes").value || null
      };

      try {
        var r = await authedFetch("/api/admin/claims/" + encodeURIComponent(claimId) + "/verify", {
          method: "PATCH",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload)
        });
        if (!r.ok) {
          var d = await r.json();
          alert(d.error || "Something went wrong.");
          card.querySelectorAll("button, input").forEach(function(b){ b.disabled = false; });
          btn.textContent = "Approve as Verified →";
          return;
        }
        card.style.opacity = "0.4";
        card.innerHTML = '<div class="mono" style="padding: 10px; color: var(--green-deep);">Approved — Profile flipped to Verified status.</div>';
      } catch(e) {
        card.querySelectorAll("button, input").forEach(function(b){ b.disabled = false; });
        btn.textContent = "Approve as Verified →";
      }
    }

    async function verifyCert(btn){
      var card = btn.closest("[data-cert]");
      var certId = card.getAttribute("data-cert");
      btn.disabled = true;
      btn.textContent = "Verifying…";

      try {
        var r = await authedFetch("/api/admin/certifications/" + encodeURIComponent(certId) + "/verify", {
          method: "PATCH"
        });
        if (!r.ok) {
          var d = await r.json();
          alert(d.error || "Something went wrong.");
          btn.disabled = false;
          btn.textContent = "Mark verified →";
          return;
        }
        card.style.opacity = "0.4";
        card.innerHTML = '<div class="mono" style="padding: 10px; color: var(--green-deep);">Certification Verified.</div>';
      } catch(e) {
        btn.disabled = false;
        btn.textContent = "Mark verified →";
      }
    }

    var EVENT_LABELS = {
      search: "Searches",
      company_view: "Profile views",
      enquiry_cta_click: "Enquiry clicks",
      enquiry_submitted: "Enquiries submitted",
      claim_submitted: "Claims submitted",
      founding_cta_click: "Founding CTA clicks",
      account_view: "Account views"
    };

    async function loadAnalytics(){
      var el = document.getElementById("analyticsBody");
      if (!el) return;

      try {
        var r = await authedFetch("/api/admin/analytics?days=30");
        var d = await r.json();
        if (!r.ok) {
          el.innerHTML = '<div class="alert-box err mono">' + esc(d.error || "Could not load analytics.") + '</div>';
          return;
        }

        var html = '<div class="telemetry-top-grid">';
        [["uniqueVisitors", "Unique Visitors"], ["sessions", "Sessions"], ["identifiedVisitors", "Identified Users"]].forEach(function(pair){
          html +=
            '<div class="telemetry-stat-card">' +
              '<div class="stat-big mono">' + (d[pair[0]] || 0) + '</div>' +
              '<div class="stat-lbl mono">' + esc(pair[1]) + '</div>' +
            '</div>';
        });
        html += '</div>';

        html += '<div class="events-grid">';
        Object.keys(EVENT_LABELS).forEach(function(key){
          var count = d.counts[key] || 0;
          html +=
            '<div class="event-tile">' +
              '<div class="event-count mono">' + count + '</div>' +
              '<div class="event-name mono">' + esc(EVENT_LABELS[key]) + '</div>' +
            '</div>';
        });
        html += '</div>';

        if (d.topSources && d.topSources.length) {
          html += '<div class="telemetry-sub-hdr mono">Traffic Sources</div><div class="telemetry-list">';
          d.topSources.forEach(function(s){
            html += '<div class="telemetry-row mono"><span>' + esc(s.source) + '</span><strong>' + s.count + ' sessions</strong></div>';
          });
          html += '</div>';
        }

        if (d.topLandingPages && d.topLandingPages.length) {
          html += '<div class="telemetry-sub-hdr mono">Top Landing Pages</div><div class="telemetry-list">';
          d.topLandingPages.forEach(function(p){
            html += '<div class="telemetry-row mono"><span>' + esc(p.page) + '</span><strong>' + p.count + '</strong></div>';
          });
          html += '</div>';
        }

        if (d.topCompanies && d.topCompanies.length) {
          html += '<div class="telemetry-sub-hdr mono">Most Viewed Profiles</div><div class="telemetry-list">';
          d.topCompanies.forEach(function(c){
            html += '<a class="telemetry-row mono" href="/companies/' + esc(c.slug) + '"><span>' + esc(c.slug) + '</span><strong>' + c.views + ' views &rarr;</strong></a>';
          });
          html += '</div>';
        }

        if (d.topQueries && d.topQueries.length) {
          html += '<div class="telemetry-sub-hdr mono">Top Search Queries</div><div class="telemetry-list">';
          d.topQueries.forEach(function(q){
            html += '<div class="telemetry-row mono"><span>' + esc(q.query) + '</span><strong>' + q.count + '&times;</strong></div>';
          });
          html += '</div>';
        }

        el.innerHTML = html;
      } catch(e) {
        el.innerHTML = '<div class="alert-box err mono">Could not load platform analytics.</div>';
      }
    }

    async function refreshFoundingCount(){
      var el = document.getElementById("foundingStatus");
      if (!el) return;

      try {
        var r = await fetch(API_BASE + "/api/founding-count");
        var d = await r.json();
        el.textContent = d.claimed + " of " + d.cap + " founding spots claimed (" + d.remaining + " remaining).";
      } catch(e) {
        el.textContent = "Could not load founding count.";
      }
    }
  })();
</script>

