---
interface Props {
  activePath?: string;
}

const { activePath = "" } = Astro.props;
---

<header class="site-header">
  <div class="wrap header-inner">
    <a href="/" class="brand" aria-label="SpecGrid Homepage">
      <div class="brand-mark" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
          <rect x="2" y="2" width="5.5" height="5.5" rx="1" fill="currentColor"/>
          <rect x="9.25" y="2" width="5.5" height="5.5" rx="1" fill="currentColor"/>
          <rect x="16.5" y="2" width="5.5" height="5.5" rx="1" fill="currentColor"/>
          <rect x="2" y="9.25" width="5.5" height="5.5" rx="1" fill="currentColor"/>
          <rect x="9.25" y="9.25" width="5.5" height="5.5" rx="1" fill="var(--green)"/>
          <rect x="16.5" y="9.25" width="5.5" height="5.5" rx="1" fill="currentColor"/>
          <rect x="2" y="16.5" width="5.5" height="5.5" rx="1" fill="currentColor"/>
          <rect x="9.25" y="16.5" width="5.5" height="5.5" rx="1" fill="currentColor"/>
          <rect x="16.5" y="16.5" width="5.5" height="5.5" rx="1" fill="currentColor"/>
        </svg>
      </div>
      <div class="brand-text">
        <span class="brand-name">Spec<span>Grid</span></span>
      </div>
    </a>

    <nav class="nav-links" aria-label="Main Navigation">
      <a href="/search" class={activePath.startsWith("/search") ? "active" : ""}>Directory</a>
      <a href="/search" class="cat-link">Categories</a>
      <a href="/for-suppliers" class={activePath === "/for-suppliers" ? "active" : ""}>For suppliers</a>
      <a href="/account" class={activePath.startsWith("/account") ? "active" : ""}>Account</a>
    </nav>

    <div class="header-actions">
      <a href="/for-suppliers" class="btn btn-dark nav-cta">List your company &rarr;</a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(236, 238, 234, 0.94);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--paper-line);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 14px;
    padding-bottom: 14px;
    gap: 16px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--ink);
  }

  .brand-mark {
    width: 32px;
    height: 32px;
    border: 1.5px solid var(--ink);
    border-radius: var(--radius);
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--ink);
    color: var(--paper);
    flex-shrink: 0;
  }

  .brand-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 20px;
    letter-spacing: -0.02em;
  }

  .brand-name span {
    color: var(--green);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .nav-links a {
    font-size: 14px;
    font-weight: 500;
    color: var(--ink-soft);
    transition: color 0.15s ease;
  }

  .nav-links a:hover,
  .nav-links a.active {
    color: var(--ink);
  }

  .nav-cta {
    font-size: 12px;
    padding: 8px 14px;
  }

  @media (max-width: 768px) {
    .nav-links {
      display: none;
    }
    .header-inner {
      padding-top: 12px;
      padding-bottom: 12px;
    }
    .nav-cta {
      font-size: 11.5px;
      padding: 7px 11px;
    }
  }
</style>
