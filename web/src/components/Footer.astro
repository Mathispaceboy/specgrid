---
// Footer.astro
---

<footer class="site-footer">
  <div class="wrap footer-inner">
    <div class="footer-col mono">
      <span>SpecGrid</span>
      <span class="sep">&middot;</span>
      <span>Built in Coimbatore</span>
      <span class="sep">&middot;</span>
      <span>&copy; {new Date().getFullYear()}</span>
      <span class="sep">&middot;</span>
      <a href="/about" class="foot-link">About</a>
    </div>

    <div class="footer-col footer-links mono">
      <a href="/terms">Terms</a>
      <span class="sep">&middot;</span>
      <a href="/privacy">Privacy</a>
      <span class="sep">&middot;</span>
      <a href="/data-disclaimer">Data Disclaimer</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--paper-line);
    margin-top: auto;
    background: var(--paper);
    padding: 24px 0 32px;
    font-size: 12px;
    color: var(--ink-soft);
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
  }

  .footer-col {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
  }

  .sep {
    color: var(--paper-line);
  }

  .footer-links a {
    color: var(--ink-soft);
    transition: color 0.15s ease;
  }

  .footer-links a:hover,
  .foot-link:hover {
    color: var(--ink);
  }

  @media (max-width: 640px) {
    .footer-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }
  }
</style>
