{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "specgrid-web",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "build": {
    "command": "cd web && npm install && npm run build"
  },
  "main": "./web/dist/_worker.js/index.js",
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS"
  }
}
